{
  "expo": {
    "name": "Sakina",
    "slug": "sakina",
    "owner": "creativeworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sakina",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060912",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sakina.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sakina uses your location to calculate accurate prayer times, the Qibla direction, and to find mosques near you.",
        "NSMotionUsageDescription": "Sakina uses the device compass to point you toward the Qibla.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sakina.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#060912",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sakina uses your location to calculate accurate prayer times, the Qibla direction, and to find mosques near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8C48A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060912",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "cd2feb9e-415b-49c0-8268-fa03d7203b05"
      }
    }
  }
}
